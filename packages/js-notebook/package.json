{
	"name": "@howaboua/pi-durable-js-notebook",
	"version": "0.8.1",
	"description": "Persistent QuickJS notebook and shell tools for Pi Durable",
	"type": "module",
	"license": "MIT",
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/js-notebook/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/js-notebook/src/index.d.ts",
			"import": "./dist/index.js"
		},
		"./worker": {
			"types": "./dist/js-notebook/src/worker.d.ts",
			"import": "./dist/worker.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"dependencies": {
		"node-pty": "1.1.0",
		"smol-toml": "1.9.0",
		"typebox": "1.3.27",
		"acorn": "8.19.0",
		"quickjs-wasi": "3.6.3",
		"@earendil-works/pi-codemode": "1.4.0"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@modelcontextprotocol/sdk": "1.25.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
