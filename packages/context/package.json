{
	"name": "@howaboua/pi-durable-context",
	"version": "0.9.1",
	"description": "Local notes, retained history and durable context rollover",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/pi-durable-components.git",
		"directory": "packages/context"
	},
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/packages/context/src/index.d.ts",
	"exports": {
		"./node": {
			"types": "./dist/packages/context/src/node.d.ts",
			"import": "./dist/node.js"
		},
		"./presentation": {
			"types": "./dist/packages/context/src/presentation.d.ts",
			"import": "./dist/presentation.js"
		},
		".": {
			"types": "./dist/packages/context/src/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"dependencies": {
		"typebox": "1.3.27"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@modelcontextprotocol/sdk": "1.25.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
