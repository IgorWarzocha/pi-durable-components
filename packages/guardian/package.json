{
	"name": "@howaboua/pi-durable-guardian",
	"version": "0.10.0",
	"description": "Explicit Durable tool rules and one-shot Codex action review",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/pi-durable-components.git",
		"directory": "packages/guardian"
	},
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/packages/guardian/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/packages/guardian/src/index.d.ts",
			"import": "./dist/index.js"
		},
		"./component": {
			"types": "./dist/packages/guardian/src/activation.d.ts",
			"import": "./dist/activation.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"peerDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@earendil-works/chord": "1.4.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@howaboua/pi-durable-components": "0.10.0"
	},
	"durable": {
		"schemaVersion": 1,
		"kind": "extension",
		"entry": "./component",
		"runtimes": [
			"node"
		],
		"requires": [],
		"permissions": []
	}
}
