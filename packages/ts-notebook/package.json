{
	"name": "@howaboua/pi-durable-ts-notebook",
	"version": "0.9.0",
	"description": "Strict TypeScript Notebook with persistent live closures and classes for Pi Durable",
	"type": "module",
	"license": "MIT",
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/ts-notebook/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/ts-notebook/src/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"dependencies": {
		"node-pty": "1.1.0",
		"smol-toml": "1.9.0",
		"typebox": "1.3.27",
		"tsrs": "0.20.0-ts7.1.0-beta",
		"@types/node": "26.6.5"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@modelcontextprotocol/sdk": "1.25.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
