{
	"name": "@howaboua/pi-durable-git",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"author": "Igor Warzocha",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"description": "Explicit native Git read capability and Durable tools",
