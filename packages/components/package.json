{
	"name": "@howaboua/pi-durable-components",
	"version": "0.10.0",
	"description": "Portable Durable component catalogues, capability contracts and activation lifecycle",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/pi-durable-components.git",
		"directory": "packages/components"
	},
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./catalogue.json": "./catalogue.json"
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE",
		"catalogue.json"
	],
	"sideEffects": false,
	"dependencies": {
		"@types/node": "26.2.0",
		"semver": "7.8.5",
		"typebox": "1.3.27"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@modelcontextprotocol/sdk": ">=1.25.2 <2"
	},
	"publishConfig": {
		"access": "public"
	},
	"durable": {
		"schemaVersion": 1,
		"kind": "library",
		"runtimes": [
			"node",
			"workerd",
			"browser"
		],
		"requires": [],
		"permissions": []
	}
}
