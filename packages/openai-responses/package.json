{
	"name": "@howaboua/pi-durable-openai-responses",
	"version": "0.10.0",
	"description": "OpenAI and Codex Responses provider with cached WebSockets and explicit Worker support",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/pi-durable-components.git",
		"directory": "packages/openai-responses"
	},
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./component": {
			"types": "./dist/activation.d.ts",
			"import": "./dist/activation.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"dependencies": {
		"openai": "7.19.0",
		"proxy-from-env": "2.1.0",
		"sharp": "0.35.5",
		"undici": "8.10.2",
		"@howaboua/pi-durable-components": "0.10.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@modelcontextprotocol/sdk": ">=1.25.2 <2"
	},
	"publishConfig": {
		"access": "public"
	},
	"durable": {
		"schemaVersion": 1,
		"kind": "provider",
		"entry": "./component",
		"runtimes": [
			"node",
			"workerd"
		],
		"requires": [
			"durable.network.v1"
		],
		"permissions": [
			"network",
			"models"
		]
	}
}
