{
	"name": "@howaboua/pi-durable-code",
	"version": "0.5.0",
	"description": "Code execution and shell tools for Pi Durable",
	"type": "module",
	"license": "MIT",
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/code/src/index.d.ts",
	"exports": {
		"./presentation": {
			"types": "./dist/code/src/presentation.d.ts",
			"import": "./dist/presentation.js"
		},
		".": {
			"types": "./dist/code/src/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"dependencies": {
		"node-pty": "1.1.0",
		"smol-toml": "1.8.0",
		"proxy-from-env": "2.1.0",
		"undici": "8.10.2",
		"typebox": "1.3.27"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.1.0",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-durable": "1.1.0",
		"@modelcontextprotocol/sdk": "1.25.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
