{
	"name": "@howaboua/pi-durable-apply-patch",
	"version": "0.5.0",
	"description": "Codex-style patches for Pi Durable",
	"type": "module",
	"license": "Apache-2.0 AND MIT",
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./presentation": {
			"types": "./dist/presentation.d.ts",
			"import": "./dist/presentation.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"peerDependencies": {
		"@earendil-works/chord": "1.1.0",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-durable": "1.1.0",
		"@modelcontextprotocol/sdk": "1.25.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
