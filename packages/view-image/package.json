{
	"name": "@howaboua/pi-durable-view-image",
	"version": "0.10.0",
	"description": "Image inspection and description for Pi Durable",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/pi-durable-components.git",
		"directory": "packages/view-image"
	},
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./presentation": {
			"types": "./dist/presentation.d.ts",
			"import": "./dist/presentation.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./component": {
			"types": "./dist/activation.d.ts",
			"import": "./dist/activation.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"dependencies": {
		"@napi-rs/image": "1.15.0",
		"sharp": "0.35.5",
		"typebox": "1.3.27",
		"@howaboua/pi-durable-components": "0.10.0"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@modelcontextprotocol/sdk": ">=1.25.2 <2"
	},
	"publishConfig": {
		"access": "public"
	},
	"durable": {
		"schemaVersion": 1,
		"kind": "extension",
		"entry": "./component",
		"runtimes": [
			"node"
		],
		"requires": [
			"durable.models.v1",
			"durable.node-execution.v1"
		],
		"permissions": [
			"filesystem",
			"models"
		]
	}
}
