{
	"name": "@howaboua/pi-durable-dictation",
	"version": "0.10.0",
	"description": "Portable local Whisper dictation with the sherpa-onnx native runtime",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/pi-durable-components.git",
		"directory": "packages/dictation"
	},
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/packages/dictation/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/packages/dictation/src/index.d.ts",
			"import": "./dist/index.js"
		},
		"./contracts": {
			"types": "./dist/packages/dictation/src/contracts.d.ts",
			"import": "./dist/contracts.js"
		},
		"./models": {
			"types": "./dist/packages/dictation/src/models.d.ts",
			"import": "./dist/models.js"
		},
		"./helpers": {
			"types": "./dist/packages/dictation/src/helpers.d.ts",
			"import": "./dist/helpers.js"
		},
		"./component": {
			"types": "./dist/packages/dictation/src/activation.d.ts",
			"import": "./dist/activation.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"sideEffects": false,
	"dependencies": {
		"sherpa-onnx-node": "1.13.8",
		"@howaboua/pi-durable-components": "0.10.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"durable": {
		"schemaVersion": 1,
		"kind": "service",
		"entry": "./component",
		"runtimes": [
			"node"
		],
		"requires": [
			"durable.node-execution.v1",
			"durable.network.v1",
			"durable.state.v1"
		],
		"permissions": [
			"filesystem",
			"process",
			"network"
		]
	}
}
