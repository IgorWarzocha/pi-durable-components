{
	"name": "@howaboua/pi-durable-gippity-voice",
	"version": "0.9.0",
	"description": "Codex subscription WebRTC voice and dictation for Pi Durable",
	"type": "module",
	"license": "MIT",
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/packages/gippity-voice/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/packages/gippity-voice/src/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src/voice/rust",
		"!src/voice/rust/target/**",
		"scripts/build-voice-helper.mjs",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"build:native": "node scripts/build-voice-helper.mjs"
	},
	"dependencies": {
		"undici": "8.10.2",
		"ws": "8.21.3"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@modelcontextprotocol/sdk": "1.25.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
