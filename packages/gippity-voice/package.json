{
	"name": "@howaboua/pi-durable-gippity-voice",
	"version": "0.10.0",
	"description": "Codex Live and OpenAI Realtime WebRTC voice and dictation for Pi Durable",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorWarzocha/pi-durable-components.git",
		"directory": "packages/gippity-voice"
	},
	"author": "Igor Warzocha",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/packages/gippity-voice/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/packages/gippity-voice/src/index.d.ts",
			"import": "./dist/index.js"
		},
		"./component": {
			"types": "./dist/packages/gippity-voice/src/activation.d.ts",
			"import": "./dist/activation.js"
		}
	},
	"files": [
		"dist",
		"src/voice/rust",
		"!src/voice/rust/target/**",
		"scripts/build-voice-helper.mjs",
		"README.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"build:native": "node scripts/build-voice-helper.mjs"
	},
	"dependencies": {
		"typebox": "1.3.27",
		"undici": "8.10.2",
		"ws": "8.21.3",
		"@howaboua/pi-durable-components": "0.10.0"
	},
	"peerDependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@modelcontextprotocol/sdk": ">=1.25.2 <2"
	},
	"publishConfig": {
		"access": "public"
	},
	"durable": {
		"schemaVersion": 1,
		"kind": "extension",
		"entry": "./component",
		"runtimes": [
			"node"
		],
		"requires": [
			"howaboua.audio.lease.v1",
			"durable.audio.webrtc-native.v1",
			"durable.node-execution.v1",
			"durable.models.v1",
			"durable.network.v1",
			"durable.state.v1"
		],
		"permissions": [
			"audio",
			"network",
			"process",
			"models",
			"storage"
		]
	}
}
